[Unit]
Description=ntp + gpsd web dashboard
After=network.target chrony.service
Wants=chrony.service

[Service]
ExecStart=/usr/bin/python3 /opt/gpsd-dashboard/gpsd-dashboard.py
Restart=on-failure
RestartSec=5

User=_chrony
Group=_chrony
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/chrony

[Install]
WantedBy=multi-user.target
