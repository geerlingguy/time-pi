# {{ ansible_managed }}

# Time Pi over WireGuard; the public servers are a sanity check and backup.
# maxdelay ignores the Time Pi over slow, uneven paths (e.g. a 5G backup link).
server {{ wg_pi_address }} iburst minpoll 0 maxpoll 4 xleave prefer maxdelay 0.05
server time.cloudflare.com iburst
server time-a-g.nist.gov iburst
server time-a-wwv.nist.gov iburst
server time-a-b.nist.gov iburst
server time.apple.com iburst

driftfile /var/lib/chrony/chrony.drift
makestep 1 3
rtcsync

# Serve time to everyone, rate limited.
allow
ratelimit interval 1 burst 16
# 256 MiB: enough to track about 2 million client IPs for rate limiting.
clientloglimit 268435456
